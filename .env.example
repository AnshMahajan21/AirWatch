# =====================================================================
# AirWatch - Atmospheric Air Quality Decision Engine Environment Config
# =====================================================================

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# =====================================================================
# AIR QUALITY DATA PROVIDER API KEYS (Cascading Priority Pipeline)
# 
# Pipeline Priority:
#  1. AQICN / WAQI API (Real-Time Ground Station Telemetry matched with aqicn.org)
#  2. data.gov.in CPCB CAAQMS API
#  3. Autonomous NCR Diurnal Harmonic Model (Zero-Network Failsafe)
# =====================================================================

# AQICN / WAQI API Token (Optional):
# Real-time ground sensor monitoring nodes across Delhi NCR and India.
# Register for a free personal token at: https://aqicn.org/api/
AQICN_API_KEY=""
# Optional alias:
# WAQI_API_TOKEN=""

# data.gov.in CPCB CAAQMS API Key:
# Official Continuous Ambient Air Quality Monitoring Stations feed from India's CPCB.
# Register for a free API key at: https://data.gov.in/
DATA_GOV_IN_API_KEY=""
# Optional alias:
# CPCB_API_KEY=""

# =====================================================================
# AI CONVERSATIONAL ASSISTANT (Dual Provider: AWS Bedrock & Gemini)
# 
# The assistant is 100% grounded in your active air quality data & exposure budget.
# Model names, vendors, and cloud providers are completely invisible to end users.
# =====================================================================

# AWS Bedrock Configuration (Primary when credentials provided):
# Supports Anthropic Claude on AWS Bedrock (Claude 3.5, 3.7, Sonnet 4.x)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional STS session token for temporary credentials:
# AWS_SESSION_TOKEN=""
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20241022-v2:0"

# Google Gemini Configuration (Automatic silent fallback):
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL_ID="gemini-3.8-flash"

# Default Provider preference ('auto' | 'bedrock' | 'gemini')
AI_DEFAULT_PROVIDER="auto"
